{
  "name": "ts-lib",
  "version": "0.0.0",
  "description": "TypeScript library template.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.1.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "build": "tsdown",
    "publint": "publint --level=warning",
    "attw": "attw --pack .",
    "prepack": "bun run build",
    "verify": "bun run test && bun run typecheck && bun run build && bun run publint && bun run attw"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  }
}
