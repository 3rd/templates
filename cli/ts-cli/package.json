{
  "name": "ts-cli",
  "version": "0.0.0",
  "description": "TypeScript CLI template.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "app": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "start:node": "node dist/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "clean": "node scripts/clean.mjs",
    "build": "bun run clean && bun build src/index.ts --target node --format esm --outfile dist/index.js && node scripts/make-executable.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "bun run build",
    "verify": "bun run test && bun run typecheck && bun run build && bun run smoke"
  },
  "dependencies": {
    "gunsmith": "^0.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3"
  }
}
