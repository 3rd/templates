{
  "name": "react-hono-pocketbase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#styles/app": "./src/client/styles.css"
  },
  "overrides": {
    "shell-quote": "1.9.0"
  },
  "scripts": {
    "dev": "concurrently -n pocketbase,server,client -c yellow,cyan,magenta \"bun run dev:pocketbase\" \"bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "vite",
    "dev:pocketbase": "cd pocketbase && go run . serve --http 127.0.0.1:8090",
    "dev:server": "bun --watch src/server/index.ts",
    "start": "bun src/server/index.ts",
    "start:node": "node --import=tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build --outDir dist/client && bun build src/server/index.ts --outdir dist/server --target bun && cd pocketbase && go build ./...",
    "test": "vitest run && cd pocketbase && go test ./...",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@hono/zod-validator": "^0.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^6.0.4",
    "hono": "^4.12.31",
    "pocketbase": "^0.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "wouter": "^3.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
