{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rs-gui-tauri",
  "version": "0.1.0",
  "identifier": "com.example.rs-gui-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "rs-gui-tauri",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": ["icons/icon.png"]
  }
}
